{
  "name": "dsh-vim-plugin",
  "description": "Vim modal editing for the dsh Web GUI composer: NORMAL/INSERT/VISUAL modes, a block caret, motions, operators, and the mode indicator",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wingillis/dsh-plugins.git",
    "directory": "plugins/dsh-vim-plugin"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "prepare": "node -e \"process.exit(require('fs').existsSync('lib/client.js') ? 0 : 1)\" || pnpm run build",
    "test": "vitest run",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-store": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-test-runtime": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "use-sync-external-store": "^1.2.0",
    "vitest": "^4.1.8"
  }
}
